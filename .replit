modules = ["nodejs-22"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd imported && PORT=5000 BASE_PATH=/ pnpm --filter @workspace/structural-app run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18293
externalPort = 3001

[[ports]]
localPort = 24596
externalPort = 3002

[deployment]
deploymentTarget = "static"
build = ["bash", "-c", "cd imported && PORT=5000 BASE_PATH=/ pnpm --filter @workspace/structural-app run build"]
publicDir = "imported/artifacts/structural-app/dist/public"
